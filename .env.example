# ---------------------------------------------------------------------------
# Frontend (build time, must be prefixed with VITE_)
# ---------------------------------------------------------------------------
# Leave unset for same-origin deployment (default — the API is served from /api on this same Vercel project).
# Only set this if you're pointing the frontend at a different backend origin.
VITE_API_BASE_URL=


# ---------------------------------------------------------------------------
# Serverless functions (runtime — set these in the Vercel project settings)
# ---------------------------------------------------------------------------

# REQUIRED. Groq API key — powers the agentic tool-calling loop, the classifier
# fallback and answer revision. Without it the API still searches and returns
# evidence, but no synthesized prose.
GROQ_API_KEY=

# Optional. Overrides the default model. Must support native tool calling and
# strict JSON Schema output — openai/gpt-oss-120b and openai/gpt-oss-20b do.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning for the LLM calls.
# GROQ_TIMEOUT_MS=45000     per-request timeout
# GROQ_MAX_RETRIES=2        retries on 429/5xx, with backoff
# GROQ_TEMPERATURE=1        gpt-oss is a reasoning model; unmodified sampling is recommended
# GROQ_TOP_P=1
# GROQ_MAX_TOKENS=2048      default cap; the agent loop raises it per depth

# Optional but recommended. Tavily gives far better web results than the keyless
# DuckDuckGo fallbacks, which cloud IPs are often rate-limited on.
# TAVILY_API_KEY=

# Optional. Gate the API behind a shared secret (sent as X-API-Key or Bearer token).
# GRAY_MATTER_API_KEY=

# Optional. Comma-separated allowed origins; "*" (default) allows all.
# CORS_ORIGINS=*

# Optional. Max request body size in bytes (default 65536).
# MAX_REQUEST_BYTES=65536
