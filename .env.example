# Gray Matter LABS — environment variables (no secrets)

VITE_APP_NAME=Gray Matter LABS

# Research agent backend (LangChain / Hugging Face Spaces)
VITE_API_BASE_URL=https://salmeida-langchain-agent.hf.space
VITE_RESEARCH_AGENT_API_URL=https://salmeida-langchain-agent.hf.space

# Public data sources (no API keys required)
VITE_ARXIV_API_URL=https://export.arxiv.org/api/query
VITE_WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1

# DuckDuckGo Instant Answer API — no key required; leave empty to use default
VITE_WEB_SEARCH_API_URL=https://api.duckduckgo.com/
