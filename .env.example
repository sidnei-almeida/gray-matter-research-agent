# ---------------------------------------------------------------------------
# Frontend (build time, must be prefixed with VITE_)
# ---------------------------------------------------------------------------
# Leave unset for same-origin deployment (default — the API is served from /api on this same Vercel project).
# Only set this if you're pointing the frontend at a different backend origin.
VITE_API_BASE_URL=


# ---------------------------------------------------------------------------
# Serverless functions (runtime — set these in the Vercel project settings)
# ---------------------------------------------------------------------------

# REQUIRED. Groq API key — powers intent classification, synthesis and revision.
# Without it the API still searches and returns evidence, but no synthesized prose.
GROQ_API_KEY=

# Optional. Overrides the default Groq model.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional but recommended. Tavily gives far better web results than the keyless
# DuckDuckGo fallbacks, which cloud IPs are often rate-limited on.
# TAVILY_API_KEY=

# Optional. Gate the API behind a shared secret (sent as X-API-Key or Bearer token).
# GRAY_MATTER_API_KEY=

# Optional. Comma-separated allowed origins; "*" (default) allows all.
# CORS_ORIGINS=*

# Optional. Max request body size in bytes (default 65536).
# MAX_REQUEST_BYTES=65536
